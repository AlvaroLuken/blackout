{
  "name": "blackout-mcp",
  "version": "0.1.1",
  "scripts": {
    "target": "NODE_NO_WARNINGS=1 tsx src/target/supervisor.ts",
    "reset": "NODE_NO_WARNINGS=1 tsx src/cli.ts reset",
    "fault": "NODE_NO_WARNINGS=1 tsx src/cli.ts fault",
    "verify": "NODE_NO_WARNINGS=1 tsx src/cli.ts verify",
    "mission": "NODE_NO_WARNINGS=1 tsx src/cli.ts mission",
    "demo": "NODE_NO_WARNINGS=1 tsx src/cli.ts demo",
    "eval": "NODE_NO_WARNINGS=1 tsx src/cli.ts eval",
    "smoke": "NODE_NO_WARNINGS=1 tsx src/llm/smoke.ts",
    "test": "NODE_NO_WARNINGS=1 node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "race": "NODE_NO_WARNINGS=1 tsx src/race.ts",
    "kill": "NODE_NO_WARNINGS=1 tsx src/cli.ts kill",
    "web": "NODE_NO_WARNINGS=1 tsx src/web/server.ts",
    "site": "NODE_NO_WARNINGS=1 tsx scripts/build-site.ts",
    "gateway": "NODE_NO_WARNINGS=1 tsx src/mcp-gateway/cli.ts",
    "gateway:demo": "NODE_NO_WARNINGS=1 tsx src/mcp-gateway/agent-demo.ts",
    "gateway:eval": "NODE_NO_WARNINGS=1 tsx src/mcp-gateway/eval.ts"
  },
  "license": "MIT",
  "description": "Exactly-once side effects for AI agents: an MCP gateway that journals every action before it runs, suppresses repeats, and reconciles from receipts after a crash. Plus the full Blackout runtime (frozen definition of done, code-only verifier).",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "openai": "^7.36.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "private": false,
  "type": "module",
  "bin": {
    "blackout-mcp": "bin/blackout-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "idempotency",
    "exactly-once",
    "nemotron",
    "crusoe",
    "reliability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlvaroLuken/blackout.git"
  },
  "homepage": "https://blackout-woad.vercel.app",
  "engines": {
    "node": ">=22.5"
  },
  "author": "Alvaro Luken"
}
